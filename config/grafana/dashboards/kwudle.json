{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Kwudle platform health: ingestion rate, DLQ depth, sampling state, alert fires, cache hit rate",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest Rate (events/s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(sentinel_ingest_events_total[1m])",
          "legendFormat": "eps"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15000 },
              { "color": "red", "value": 20000 }
            ]
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DLQ Depth",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sentinel_dlq_depth",
          "legendFormat": "records"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DLQ Oldest Record Age (s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sentinel_dlq_oldest_record_age_seconds",
          "legendFormat": "seconds"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker Up",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "datasource": "Prometheus", "expr": "sentinel_worker_up", "legendFormat": "up" }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingestion Rate (eps)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(sentinel_ingest_events_total[1m])",
          "legendFormat": "events/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15000 },
              { "color": "red", "value": 20000 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DLQ Depth Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "datasource": "Prometheus", "expr": "sentinel_dlq_depth", "legendFormat": "DLQ records" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sampling Keep Rate by Event Type",
      "description": "Pulled from sentinel.sampling_rules via /metrics once exposed. Tracks when pressure valve activates.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "datasource": "Prometheus", "expr": "sentinel_sampling_keep_rate", "legendFormat": "{{event_type}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": { "lineWidth": 2 }
        }
      }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["kwudle", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Kwudle Platform Health",
  "uid": "kwudle-platform-health",
  "version": 1
}
