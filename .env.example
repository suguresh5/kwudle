# ─────────────────────────────────────────────────────────────
#  Sentinel — Titan Protocol  |  .env.example
#  Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=change_me_strong_password
CLICKHOUSE_USER=sentinel_user
CLICKHOUSE_DB=sentinel

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_MAXMEMORY=512mb

# ── PII / Security ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
PII_HASH_SALT=change_me_generate_with_openssl_rand_base64_32

# ── Admin auth ────────────────────────────────────────────────
ADMIN_JWT_SECRET=change_me_admin_jwt_secret

# ── GeoIP ─────────────────────────────────────────────────────
# Download GeoLite2-City.mmdb from MaxMind, place at ./data/geoip/
GEOIP_DB_PATH=/data/geoip/GeoLite2-City.mmdb

# ── Dashboard ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_INGEST_URL=http://localhost:8080

# ── Alerting ──────────────────────────────────────────────────
DEFAULT_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# ── Batcher tuning ────────────────────────────────────────────
BATCHER_FLUSH_SIZE=10000
BATCHER_FLUSH_INTERVAL_MS=5000
BATCHER_RETRY_INITIAL_MS=500
BATCHER_RETRY_MAX_MS=30000
BATCHER_MAX_RETRIES=5

# ── Sampling ──────────────────────────────────────────────────
SAMPLING_THRESHOLD=20000

# ── Enrichment ────────────────────────────────────────────────
ENRICHMENT_TIMEOUT_MS=2

# ── AI Suggestions (Anthropic / Claude) ───────────────────────
# Get key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Worker → Dashboard internal calls ─────────────────────────
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_generate_with_openssl_rand_hex_32
DASHBOARD_INTERNAL_URL=http://sentinel-dashboard:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

